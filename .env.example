# ================================================
# 사용법
# 1. 이 파일을 복사해서 .env 파일을 만드세요 (터미널에서 아래 명령어 실행)
#    cp .env.example .env
# 2. 아래 값들을 실제 값으로 채우세요 (팀 공지사항 참고). 모르는 값은 빈칸으로 두세요 (빈칸이면 기본값·기본 자격증명을 씀)
# 3. .env는 .gitignore에 등록되어 있어 git에 올라가지 않습니다.
# 4. 값에 따옴표(" ')를 넣지 마세요.
# ================================================

# AWS S3 — 로컬에서 뉴스기사 백업·복구, 로그 적재 기능을 실행·테스트할 때 필요
# 로컬 개발용으로 따로 발급한 S3 전용 액세스 키와 버킷 이름 (값은 팀장이 따로 전달). S3 기능을 안 건드리면 비워 둬도 앱은 뜬다
# 배포 서버는 이 값을 쓰지 않고 ECS 역할 권한으로 S3에 접근한다
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# 뉴스기사 수집용 네이버 뉴스 API 키
NAVER_API_CLIENT_ID=
NAVER_API_CLIENT_SECRET=
