#!/bin/sh
# push 전 포맷 검사와 본 코드(src/main) 컴파일만 빠르게 돌려, CI에서 바로 깨질 코드가 올라가지 않게 한다.
# 테스트 컴파일·실행은 하지 않고 CI가 PR마다 검사한다.

# 브랜치 삭제 push는 검사하지 않는다.
ZERO=0000000000000000000000000000000000000000
HAS_UPDATE=0
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  [ "$LOCAL_SHA" != "$ZERO" ] && HAS_UPDATE=1
done
[ "$HAS_UPDATE" -eq 0 ] && exit 0

echo "[pre-push] 포맷 검사·본 코드 컴파일 중... (spotlessCheck, compileJava)"
# MONEW_GIT_HOOK=1: 실행 중인 훅 파일을 build.gradle이 다시 복사하지 않게 한다 (pre-commit과 같은 이유)
if ! MONEW_GIT_HOOK=1 ./gradlew spotlessCheck compileJava -q; then
  echo ""
  echo "❌ [pre-push] 포맷 오류 또는 컴파일 오류가 있어 push를 중단합니다."
  echo "   포맷 오류: ./gradlew spotlessApply"
  echo ""
  exit 1
fi
exit 0
