#!/bin/sh

COMMIT_MSG_FILE="$1"
TYPES='feat|fix|refactor|docs|chore|test|batch|merge|revert'

FIRST_LINE=$(awk '/^[[:space:]]*#/{next} NF{print; exit}' "$COMMIT_MSG_FILE")

# rebase 때 합쳐져 사라지는 임시 커밋은 형식 검사 없이 통과
case "$FIRST_LINE" in
  "fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

# 글자 수 (한글도 1자로 셈)
char_len() {
  printf '%s' "$1" | LC_ALL=C tr -d '\200-\277' | wc -c | tr -d ' '
}

# $2자를 넘으면 뒤를 잘라 …을 붙임
cut_chars() {
  CUT_TEXT="$1"
  if [ "$(char_len "$CUT_TEXT")" -le "$2" ]; then
    printf '%s' "$CUT_TEXT"
    return
  fi
  CONT="$(printf '\200')-$(printf '\277')"
  while [ "$(char_len "$CUT_TEXT")" -gt $(($2 - 1)) ]; do
    CUT_TEXT=$(printf '%s' "$CUT_TEXT" | LC_ALL=C sed -E "s/[^$CONT][$CONT]*\$//")
  done
  printf '%s…' "$CUT_TEXT"
}

# Git이 영어로 만드는 머지·되돌리기 커밋 제목을 팀 형식으로 바꿈 (이슈 번호는 아래에서 붙음)
#   Merge branch 'develop' of https://… into feat/47-…  → merge : develop 최신 내용 반영
#   Merge origin/develop into feat/33-… (인텔리제이)     → merge : develop 최신 내용 반영
#   Revert "feat : 관심사 등록 [#30]"                    → revert : 관심사 등록 되돌리기
NEW_TITLE=""
SRC=""
case "$FIRST_LINE" in
  "Merge commit '"*|"Merge branches "*)
    NEW_TITLE="merge : 브랜치 병합" ;;
  "Merge branch '"*|"Merge remote-tracking branch '"*|"Merge tag '"*)
    SRC=$(printf '%s' "$FIRST_LINE" | sed -E "s/^Merge [a-z -]+'([^']+)'.*/\1/") ;;
  "Merge "*" into "*)
    SRC=$(printf '%s' "$FIRST_LINE" | awk '{print $2}') ;;
  "Merge "*)
    NEW_TITLE="merge : 브랜치 병합" ;;
  "Revert "*)
    INNER=$(printf '%s' "$FIRST_LINE" | sed -E \
      -e 's/^Revert "(.*)"$/\1/' \
      -e 's/^[^A-Za-z[]*\[/[/' \
      -e "s/^($TYPES)(\((red|green|blue)\))?[[:space:]]*:[[:space:]]*//" \
      -e 's/^\[[A-Za-z]+\][[:space:]]*:[[:space:]]*//' \
      -e 's/[[:space:]]*(\[#[0-9]+\]|\(#[0-9]+\))[[:space:]]*$//')
    # 되돌린 걸 다시 되돌리면 "다시 적용", 그걸 또 되돌리면 다시 "되돌리기"
    case "$INNER" in
      *" 되돌리기")
        NEW_TITLE="revert : $(cut_chars "${INNER% 되돌리기}" 45) 다시 적용" ;;
      *" 다시 적용")
        NEW_TITLE="revert : $(cut_chars "${INNER% 다시 적용}" 46) 되돌리기" ;;
      "")
        NEW_TITLE="revert : 커밋 되돌리기" ;;
      *)
        NEW_TITLE="revert : $(cut_chars "$INNER" 46) 되돌리기" ;;
    esac ;;
esac
if [ -n "$SRC" ]; then
  NEW_TITLE="merge : $(cut_chars "${SRC#origin/}" 43) 최신 내용 반영"
fi
if [ -n "$NEW_TITLE" ]; then
  NEW_TITLE="$NEW_TITLE" awk '
    !done && !/^[[:space:]]*#/ && NF { print ENVIRON["NEW_TITLE"]; done = 1; next }
    { print }
  ' "$COMMIT_MSG_FILE" > "${COMMIT_MSG_FILE}.tmp" && mv "${COMMIT_MSG_FILE}.tmp" "$COMMIT_MSG_FILE"
fi

# 제목(첫 번째 주석 아닌 비어있지 않은 줄) 줄 번호를 먼저 구함
TITLE_LINE=$(awk '/^[[:space:]]*#/{next} NF{print NR; exit}' "$COMMIT_MSG_FILE")

if [ -n "$TITLE_LINE" ]; then
  # 타입 단축키 자동 변환.
  # 구분자는 콜론(:)뿐 아니라 세미콜론(;)도 허용
  # 일반 단축키: f/x/c/r/d/t/b → feat/fix/chore/refactor/docs/test/batch
  # TDD 단계 단축키: 타입 뒤에 그냥 1만 붙임
  #   t1→test(red), f1→feat(green), x1→fix(green), r1→refactor(blue)
  #   (Red는 test, Green은 feat 또는 fix, Blue는 refactor)
  sed -i.bak -E \
    -e "${TITLE_LINE}s/^t1[[:space:]]*[:;][[:space:]]*/test(red) : /" \
    -e "${TITLE_LINE}s/^f1[[:space:]]*[:;][[:space:]]*/feat(green) : /" \
    -e "${TITLE_LINE}s/^x1[[:space:]]*[:;][[:space:]]*/fix(green) : /" \
    -e "${TITLE_LINE}s/^r1[[:space:]]*[:;][[:space:]]*/refactor(blue) : /" \
    -e "${TITLE_LINE}s/^f[[:space:]]*[:;][[:space:]]*/feat : /" \
    -e "${TITLE_LINE}s/^x[[:space:]]*[:;][[:space:]]*/fix : /" \
    -e "${TITLE_LINE}s/^c[[:space:]]*[:;][[:space:]]*/chore : /" \
    -e "${TITLE_LINE}s/^r[[:space:]]*[:;][[:space:]]*/refactor : /" \
    -e "${TITLE_LINE}s/^d[[:space:]]*[:;][[:space:]]*/docs : /" \
    -e "${TITLE_LINE}s/^t[[:space:]]*[:;][[:space:]]*/test : /" \
    -e "${TITLE_LINE}s/^b[[:space:]]*[:;][[:space:]]*/batch : /" \
    "$COMMIT_MSG_FILE" && rm -f "${COMMIT_MSG_FILE}.bak"

  # 타입(또는 타입+단계) 뒤 구분자(콜론/세미콜론) 앞뒤 공백을 "타입 : " 한 가지 모양으로 통일
  # — 제목 줄에만 적용
  sed -i.bak -E \
    -e "${TITLE_LINE}s/^(($TYPES)(\((red|green|blue)\))?)[[:space:]]*[:;][[:space:]]*/\1 : /" \
    "$COMMIT_MSG_FILE" && rm -f "${COMMIT_MSG_FILE}.bak"

  sed -i.bak -E \
    -e "${TITLE_LINE}s/[[:space:]]+;[[:space:]]*c[[:space:]]*\$/ (클로드 리뷰 반영 수정)/" \
    -e "${TITLE_LINE}s/[[:space:]]+;[[:space:]]*r[[:space:]]*\$/ (코드래빗 리뷰 반영 수정)/" \
    -e "${TITLE_LINE}s/[[:space:]]+;[[:space:]]*t[[:space:]]*\$/ (팀원 피드백 반영 수정)/" \
    "$COMMIT_MSG_FILE" && rm -f "${COMMIT_MSG_FILE}.bak"

  # 브랜치명({타입}/{이슈번호}-{키워드})에서 이슈번호를 추출해 제목 끝에 자동으로 붙임
  # 이미 [#번호]가 있으면 중복으로 안 붙임. develop/main처럼 이슈번호가 없는 브랜치면 조용히 건너뜀
  BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)
  ISSUE_NUM=$(echo "$BRANCH" | sed -nE 's#^[a-z]+/([0-9]+)-.*#\1#p')
  if [ -n "$ISSUE_NUM" ]; then
    CURRENT_TITLE=$(sed -n "${TITLE_LINE}p" "$COMMIT_MSG_FILE")
    if ! echo "$CURRENT_TITLE" | grep -Eq '\[#[0-9]+\][[:space:]]*$'; then
      sed -i.bak -E "${TITLE_LINE}s/[[:space:]]*\$/ [#${ISSUE_NUM}]/" \
        "$COMMIT_MSG_FILE" && rm -f "${COMMIT_MSG_FILE}.bak"
    fi
  fi
fi

# 주석과 빈 줄을 제외한 첫 번째 줄을 커밋 제목으로 사용
TITLE=$(grep -vE '^[[:space:]]*#' "$COMMIT_MSG_FILE" | sed '/^[[:space:]]*$/d' | head -n 1)

print_examples() {
  echo "단축키 입력 예시 (타입 단축키 + 콜론(:) 또는 세미콜론(;)만 치면 자동 변환):"
  echo "  f : 관심사 등록 API 추가        → feat : …"
  echo "  x : 뉴스기사 중복 저장 오류 수정 → fix : …"
  echo "  r : 알림 이벤트 발행 구조 분리   → refactor : …"
  echo "  d : README 프로젝트 실행 방법 추가 → docs : …"
  echo "  c : build.gradle 의존성 정리    → chore : …"
  echo "  t : 관심사 등록 테스트 추가      → test : …"
  echo "  b : 뉴스기사 수집 배치 주기 변경 → batch : …"
  echo ""
  echo "TDD 커밋 단축키:"
  echo "  t1 : 관심사 등록 실패 테스트 추가   → test(red) : …"
  echo "  f1 : 관심사 등록 구현              → feat(green) : …"
  echo "  x1 : 중복 저장 오류 수정           → fix(green) : …"
  echo "  r1 : 관심사 서비스 정리            → refactor(blue) : …"
  echo ""
  echo "리뷰 반영 단축키 (제목 맨 끝에 띄어쓰기 + ;c / ;r / ;t, \"; c\"처럼 띄어 써도 됨):"
  echo "  c : 설정파일 수정 ;c → chore : 설정파일 수정 (클로드 리뷰 반영 수정)"
  echo "  f : 관심사 등록 ;r   → feat : 관심사 등록 (코드래빗 리뷰 반영 수정)"
  echo "  x : 중복 저장 수정 ;t → fix : 중복 저장 수정 (팀원 피드백 반영 수정)"
  echo ""
  echo "이슈 번호는 현재 브랜치명에서 자동으로 추출해 제목 끝에 붙습니다 (직접 안 적어도 됨):"
  echo "  t1 : 관심사 등록 실패 테스트 추가  →  test(red) : 관심사 등록 실패 테스트 추가 [#30]"
}

# 제목 비어있는지 검사
if [ -z "$TITLE" ]; then
  echo ""
  echo "커밋 메시지를 입력해주세요."
  echo ""
  print_examples
  echo ""
  exit 1
fi

# 70자 이하 검사
TITLE_LENGTH=$(printf "%s" "$TITLE" | LC_ALL=C tr -d '\200-\277' | wc -c | tr -d ' ')

if [ "$TITLE_LENGTH" -gt 70 ]; then
  echo ""
  echo "커밋 제목은 70자 이하로 작성해주세요."
  echo "현재 글자 수: $TITLE_LENGTH"
  echo "현재 제목: $TITLE"
  echo ""
  echo "수정 예시:"
  echo "  feat : 관심사 등록 API 추가"
  echo "  fix : 중복 저장 오류 수정"
  echo ""
  exit 1
fi

# 허용 형식 검사: "타입 : 내용" 또는 "타입(단계) : 내용"
if ! echo "$TITLE" | grep -Eq "^($TYPES)(\((red|green|blue)\))? : .+"; then
  echo ""
  echo "커밋 메시지 형식이 올바르지 않습니다."
  echo ""
  echo "사용 가능한 타입:"
  echo "  feat : 새로운 기능/파일 추가"
  echo "  fix : 코드 수정"
  echo "  refactor : 코드 리팩토링 (파일/폴더명 변경 포함)"
  echo "  docs : README와 같은 문서 수정"
  echo "  chore : 코드 로직과 무관한 설정/빌드/도구 변경"
  echo "  test : 테스트 코드 추가/수정 (TDD 사이클 커밋 포함)"
  echo "  batch : 배치 작업 관련 변경"
  echo "  merge : 다른 브랜치 내용 반영 (머지 커밋, 보통 자동으로 붙음)"
  echo "  revert : 이전 커밋 되돌리기 (git revert, 보통 자동으로 붙음)"
  echo ""
  print_examples
  echo ""
  echo "현재 입력된 커밋 메시지:"
  echo "  $TITLE"
  echo ""
  exit 1
fi

# TDD 단계와 타입이 맞는지 검사 (Red=test, Green=feat/fix, Blue=refactor)
STAGE_ERROR=""
case "$TITLE" in
  "test(red) :"*|"feat(green) :"*|"fix(green) :"*|"refactor(blue) :"*) ;;
  *"(red) :"*) STAGE_ERROR="Red 단계(t1)는 실패하는 테스트를 쓰는 단계라 test 타입만 쓸 수 있습니다. 예: t1 : …" ;;
  *"(green) :"*) STAGE_ERROR="Green 단계(f1/x1)는 기능·수정 코드로 테스트를 통과시키는 단계라 feat 또는 fix 타입만 쓸 수 있습니다. 예: f1 : … / x1 : …" ;;
  *"(blue) :"*) STAGE_ERROR="Blue 단계(r1)는 동작을 바꾸지 않고 정리하는 단계라 refactor 타입만 쓸 수 있습니다. 예: r1 : …" ;;
esac

if [ -n "$STAGE_ERROR" ]; then
  echo ""
  echo "TDD 단계와 커밋 타입이 맞지 않습니다."
  echo "  $STAGE_ERROR"
  echo ""
  echo "현재 입력된 커밋 메시지:"
  echo "  $TITLE"
  echo ""
  exit 1
fi

exit 0
